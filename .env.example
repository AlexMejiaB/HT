# Plantilla de variables de entorno de Highticket.
#
#   cp .env.example .env    y llena los valores
#
# Ninguna de estas variables se versiona: `.gitignore` excluye `.env*` y sólo
# deja pasar este archivo. Si añades una variable nueva, agrégala aquí también
# o el siguiente que despliegue no sabrá que existe.

# ---------------------------------------------------------------- Base de datos
# En desarrollo se usa un Postgres en podman (puerto 5433) para no chocar con el
# del sistema. En el VPS apunta al Postgres local del servidor.
DATABASE_URL="postgresql://usuario:contrasena@127.0.0.1:5433/highticket?schema=public"

# ------------------------------------------------------------------- Secretos
# Genéralos así, uno por entorno. NUNCA reutilices los de desarrollo en producción.
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
CLAVE_CIFRADO=""
#   node -e 'console.log(require("crypto").randomBytes(48).toString("hex"))'
SECRETO_SESION=""

# ------------------------------------------------------------------ Meta / WhatsApp
# Del panel de tu app en developers.facebook.com.
# El app secret firma los webhooks; el verify token lo eliges tú y lo pegas
# igual en la configuración del webhook de Meta.
META_APP_SECRET=""
META_VERIFY_TOKEN=""

# ------------------------------------------------------------------------ Modelo
# Cualquier API con forma de OpenAI sirve. Por defecto, Gemini directo.
#   Llave en https://aistudio.google.com/apikey
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
LLM_MODELO="gemini-3.7-flash"
LLM_API_KEY=""
# Los modelos que razonan gastan tokens pensando y truncan la respuesta si el
# presupuesto es corto. "none" ahorra ~39% sin romper nada.
#   Valores: none | low | medium | high | omitir (no manda el parámetro)
LLM_RAZONAMIENTO="none"

# ------------------------------------------------------------------------- Sitio
# En producción: https://highticket.app
# El dominio importa: se usa para armar la URL del webhook que ve el cliente.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Contacto directo que aparece en la landing, con lada de país y sólo dígitos.
NEXT_PUBLIC_WHATSAPP_NUMERO="524445587796"
# Opcional. Si está vacío, los botones de "agendar" caen a WhatsApp.
NEXT_PUBLIC_CALENDLY_URL=""
